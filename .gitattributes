# 通用规则：所有文本文件提交时强制LF，检出时按系统自动转换
* text=auto

# 明确指定文本文件类型（补充auto规则）
*.c text
*.cpp text
*.h text
*.hpp text
*.java text
*.py text
*.sh text
*.bat text
*.md text
*.txt text
*.json text
*.yml text
*.yaml text
*.xml text
*.js text
*.ts text
*.css text
*.html text

# 二进制文件（禁止Git修改换行符，防止损坏）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar.gz binary
*.exe binary
*.dll binary
*.so binary
*.obj binary
*.class binary

# 特殊文件：Shell脚本强制LF（无论系统）
*.sh text eol=lf
# Windows批处理强制CRLF（无论系统）
*.bat text eol=crlf
# Git配置文件强制LF
.gitconfig text eol=lf
.gitattributes text eol=lf